{
  "name": "dungeons-arena",
  "version": "0.1.0",
  "private": true,
  "description": "RPG de ação em tempo real para navegador: campanha solo, arena multiplayer e editor de fases.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "servidor": "tsx server/main.ts",
    "carga": "tsx tools/carga/carga.ts",
    "relatorios": "tsx tools/relatorios/resumo.ts",
    "balancear": "tsx tools/balanceamento/balancear.ts",
    "balancear:diagnostico": "tsx tools/balanceamento/balancear.ts --diagnostico",
    "balancear:completo": "npm run balancear && npm run balancear:diagnostico",
    "bench": "npm run build && tsx tools/bench/bench.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.nucleo.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verificar": "npm run typecheck && npm run lint && npm test && npm run build && npm run balancear:completo",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist-server/main.mjs",
    "bench:fases": "tsx tools/bench/fases-vivas.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "@supabase/supabase-js": "2.117.2",
    "pixi.js": "8.22.0"
  }
}
